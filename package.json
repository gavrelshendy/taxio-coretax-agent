{
  "name": "coretax-agent",
  "version": "4.0.0",
  "private": true,
  "description": "Standalone desktop app for Coretax automation - connects directly to your Taxio/Taxio.me account (email+password) and drives Coretax DJP via Playwright, controlled through a local GUI dashboard instead of a console.",
  "author": "Taxio",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "headless": "node main.js",
    "build": "electron-builder --win nsis --x64 --publish never",
    "test": "node scripts/run-tests.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "playwright": "1.61.1"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.taxio.pilot",
    "productName": "Taxio Pilot",
    "executableName": "taxio-pilot",
    "copyright": "Taxio",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "package.json",
      "electron/**/*",
      "lib/**/*",
      "gui/**/*",
      "automation/**/*",
      "config/**/*",
      "!**/*.xlsx",
      "gui/public/assets/template-pajak-masukan.xlsx",
      "!**/.env",
      "!**/.env.*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/playwright-core/**",
      "node_modules/playwright/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "gui/public/assets/coretax-agent-icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "taxio-pilot-setup-${version}.${ext}",
      "shortcutName": "Taxio Pilot",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/gavrelshendy/taxio-coretax-agent/releases/download/pilot-v4/"
      }
    ]
  }
}

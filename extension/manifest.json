{
  "manifest_version": 3,
  "name": "Coretax - Unduh Lampiran SPT",
  "version": "1.2.0",
  "description": "Mengunduh lampiran SPT PPh Badan, OP, PPh 21/26, PPh Unifikasi, dan PPN dari Coretax DJP sebagai PDF per lampiran maupun gabungan.",
  "permissions": [
    "debugger",
    "downloads",
    "offscreen"
  ],
  "host_permissions": [
    "https://coretaxdjp.pajak.go.id/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://coretaxdjp.pajak.go.id/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
